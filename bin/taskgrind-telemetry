#!/bin/bash
# Opt-in field telemetry: send anonymous usage counts from the usage log to PostHog EU.
#
# Usage:
#   taskgrind telemetry status          Show on/off, why, pending events, last send
#   taskgrind telemetry on | off        Turn sending on or off on this machine
#   taskgrind telemetry send [--dry-run]  Send pending events now; --dry-run prints
#                                       the exact request body (key hidden), sends nothing
#   taskgrind telemetry daily           Send at most once a day (a finished grind calls it)
#   taskgrind telemetry notice          Print the one-line notice once
#
# This script is the only adapter between the content-free usage log
# (TG_USAGE_LOG, default ~/.local/state/taskgrind/usage.jsonl, written by
# record_usage_event in bin/taskgrind) and the endpoint, so a move to a
# self-hosted endpoint changes only this file. Same contract as careerbrew's
# telemetry.py and agentbrew's core/telemetry.ts.
#
# What leaves the machine: per usage line, `taskgrind.<event>`, its time, the
# reason and backend codes, ok, and the number fields (sessions, shipped,
# zero_ship, tasks_added, remaining, elapsed_s, sweeps), keyed by a random
# install id. Never a repo name, path, prompt, task text, host, or user name.
# Person profiles and GeoIP are off.
#
# It sends nothing unless all hold: a project key is set (TASKGRIND_POSTHOG_KEY,
# or the macOS Keychain item service "taskgrind", account "posthog_key"),
# telemetry is on (the default), DO_NOT_TRACK is unset, and the notice was shown.
# A failed send never fails a grind. The cursor moves only after a send works.
#
# Lifecycle: the install id, the cursor (usage lines already sent), the on/off
# flag, the last send day, and the notice flag live in one file,
# ${XDG_STATE_HOME:-~/.local/state}/taskgrind/telemetry.json (mode 600).
# Delete it to reset: a new install id, and the whole log is sent again.

set -uo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; /^# shellcheck/d; s/^# \{0,1\}//p' "$0"; exit 0; }

TASKGRIND_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATS="${TG_USAGE_LOG:-${DVB_USAGE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/taskgrind/usage.jsonl}}"
STATE="${TASKGRIND_TELEMETRY_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/taskgrind/telemetry.json}"
URL="${TASKGRIND_TELEMETRY_URL:-https://eu.i.posthog.com}"
URL="${URL%/}/batch/"
CURL="${TASKGRIND_TELEMETRY_CURL:-curl}"
BATCH_SIZE=500
NOTICE="taskgrind sends anonymous usage counts (grind ok or error, duration, counts; never paths, names, or content) to PostHog EU once a key is set. Turn off: taskgrind telemetry off (or DO_NOT_TRACK=1)."

command -v jq >/dev/null 2>&1 || { echo "✗ jq is not installed. Fix: brew install jq" >&2; exit 1; }

load_state() {
  local s=""
  [ -s "$STATE" ] && s="$(jq -c '.' "$STATE" 2>/dev/null)"
  [ -n "$s" ] || s='{}'
  jq -c '{install_id: (.install_id // ""), sent: (.sent // 0), enabled: (if .enabled == false then false else true end), last_send: (.last_send // ""), noticed: (.noticed // false)}' <<<"$s"
}

save_state() {
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || return 0
  (umask 077 && printf '%s\n' "$1" >"$STATE.tmp.$$" && mv "$STATE.tmp.$$" "$STATE") 2>/dev/null || rm -f "$STATE.tmp.$$"
}

state_get() { jq -r ".$1" <<<"$STATE_JSON"; }
state_set() { STATE_JSON="$(jq -c --argjson v "$2" ".$1 = \$v" <<<"$STATE_JSON")"; save_state "$STATE_JSON"; }

STATE_JSON="$(load_state)"
if [ -z "$(state_get install_id)" ]; then
  state_set install_id "\"$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')\""
fi

# The project key, or "". TASKGRIND_POSTHOG_KEY, when set (tests set it empty),
# wins over the Keychain; a bats test never reads the Keychain. The value is never printed or logged.
project_key() {
  if [ -n "${TASKGRIND_POSTHOG_KEY+x}" ]; then printf '%s' "$TASKGRIND_POSTHOG_KEY"; return; fi
  [ "$(uname -s)" = "Darwin" ] || return 0
  [ -z "${BATS_TEST_FILENAME:-}" ] || return 0  # a test never reads the real Keychain
  security find-generic-password -s taskgrind -a posthog_key -w 2>/dev/null || true
}

# Why sending is off by a switch (not by a missing key), or "".
blocked() {
  case "${DO_NOT_TRACK:-}" in "" | 0) ;; *) echo "DO_NOT_TRACK is set"; return ;; esac
  [ "$(state_get enabled)" = "true" ] || echo "turned off (turn on: taskgrind telemetry on)"
}

line_count() { [ -f "$STATS" ] && wc -l <"$STATS" | tr -d ' ' || echo 0; }

pending_count() {
  local total sent
  total="$(line_count)"; sent="$(state_get sent)"
  [ "$sent" -le "$total" ] 2>/dev/null || sent=0
  echo $((total - sent))
}

# Lines from $1+1, at most $2 of them, as a PostHog batch body with key $3.
# Allowlisted fields only: anything else in a line never leaves the Mac.
build_body() {
  local from="$1" count="$2" key="$3" version
  version="$(git -C "$TASKGRIND_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  tail -n "+$((from + 1))" "$STATS" 2>/dev/null | head -n "$count" | jq -R -s -c \
    --arg key "$key" --arg id "$(state_get install_id)" --arg v "$version" '
    def num: type == "number" and isinfinite == false and isnan == false;
    [split("\n")[] | select(length > 0) | (try fromjson catch null) | select(type == "object") | . as $e |
      select(($e.event | type) == "string" and ($e.event | test("^[a-z0-9_-]{1,32}$"))) |
      {event: ("taskgrind." + $e.event), distinct_id: $id,
       properties: ({"$process_person_profile": false, "$geoip_disable": true, app_version: $v}
         + ([("reason","backend") as $k | select(($e[$k] | type) == "string" and ($e[$k] | test("^[a-z0-9_-]{1,40}$"))) | {($k): $e[$k]}] | add // {})
         + ([("v","sessions","shipped","zero_ship","tasks_added","remaining","elapsed_s","sweeps","failed_checks") as $k
              | select($e[$k] | num) | {($k): $e[$k]}] | add // {})
         + (if ($e.ok | type) == "boolean" then {ok: $e.ok} else {} end))}
      + (if ($e.ts | type) == "string" and ($e.ts | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) then {timestamp: $e.ts} else {} end)
    ] | {api_key: $key, batch: .}'
}

# POST stdin to the endpoint; prints the HTTP status. The body (with the key)
# goes through stdin, so the key never shows in a process list.
post() {
  "$CURL" -sS -o /dev/null -w '%{http_code}' --max-time 10 -X POST \
    -H 'Content-Type: application/json' --data-binary @- "$URL" 2>/dev/null || echo 000
}

cmd_status() {
  local why key_state="no key"
  why="$(blocked)"
  [ -n "$(project_key)" ] && key_state="key set"
  if [ -n "$why" ]; then echo "telemetry: off ($why)"
  elif [ "$key_state" = "no key" ]; then echo "telemetry: off (no key, so nothing is sent; set one: security add-generic-password -s taskgrind -a posthog_key -w)"
  else echo "telemetry: on"; fi
  echo "endpoint: $URL"
  echo "pending: $(pending_count) event(s)"
  echo "last send: $(state_get last_send | sed 's/^$/never/')"
}

cmd_send() {
  local dry=0 sent from total n code key
  [ "${1:-}" = "--dry-run" ] && dry=1
  sent="$(state_get sent)"; total="$(line_count)"
  [ "$sent" -le "$total" ] 2>/dev/null || sent=0
  if [ "$dry" -eq 1 ]; then
    echo "POST $URL"
    build_body "$sent" "$BATCH_SIZE" "<posthog_key>" | jq .
    return 0
  fi
  local why; why="$(blocked)"
  [ -z "$why" ] || { echo "telemetry: not sent ($why)"; return 0; }
  key="$(project_key)"
  [ -n "$key" ] || { echo "telemetry: not sent (no key)"; return 0; }
  [ "$total" -gt "$sent" ] || { echo "telemetry: nothing new"; return 0; }
  from="$sent"
  while [ "$from" -lt "$total" ]; do
    n=$((total - from)); [ "$n" -gt "$BATCH_SIZE" ] && n="$BATCH_SIZE"
    code="$(build_body "$from" "$n" "$key" | post)"
    case "$code" in 2??) ;; *) echo "telemetry: send failed (http $code); will retry"; return 0 ;; esac
    from=$((from + n))
    state_set sent "$from"
  done
  state_set last_send "\"$(date -u +%F)\""
  echo "telemetry: sent $((from - sent)) event(s)"
}

cmd_daily() {
  [ "$(state_get noticed)" = "true" ] || return 0
  [ "$(state_get last_send)" = "$(date -u +%F)" ] && return 0
  [ -z "$(blocked)" ] || return 0
  cmd_send >/dev/null 2>&1 || true
}

cmd_notice() {
  [ "$(state_get noticed)" = "true" ] && return 0
  [ -z "$(blocked)" ] || return 0
  [ -n "$(project_key)" ] || return 0
  state_set noticed true
  echo "$NOTICE"
}

case "${1:-status}" in
  status) cmd_status ;;
  on) state_set enabled true; echo "telemetry: turned on" ;;
  off) state_set enabled false; echo "telemetry: turned off" ;;
  send) shift; cmd_send "$@" ;;
  daily) cmd_daily ;;
  notice) cmd_notice ;;
  *) echo "Unknown subcommand: $1 (see taskgrind telemetry --help)" >&2; exit 2 ;;
esac
exit 0
